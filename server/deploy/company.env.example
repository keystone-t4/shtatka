# Скопировать в /etc/shtatka/company.env, права 600, владелец root
PORT=8787
# Сайты, которым разрешено обращаться к сервису (через запятую, без / в конце)
ALLOW_ORIGIN=https://штатка.рф,https://xn--80aa3a4ab7a.xn--p1ai,https://shtatka.ru
# Ключ DaData: ОКВЭД и запасной источник реквизитов. Можно оставить пустым.
DADATA_TOKEN=
# Сколько часов хранить ответ по одному ИНН
CACHE_HOURS=24
# Распознавание паспорта (Yandex Vision OCR): API-ключ сервисного аккаунта с ролью ai.vision.user и id каталога.
# Пусто — /passport отвечает 503, форма предлагает ввести данные вручную.
YC_API_KEY=
YC_FOLDER_ID=

# --- Вход и подтверждение компании по ЭЦП (КЭП) ---
# Файл со списком аккредитованных УЦ (PEM, корневые и промежуточные). Источник: TSL на e-trust.gosuslugi.ru.
# Без него сервер отвечает no_trust_store и никого не подтверждает.
ESIGN_CA_BUNDLE=/etc/shtatka/trust.pem
# Секрет для подписи сессионных токенов (длинная случайная строка)
ESIGN_SECRET=
# Подписи ГОСТ Р 34.10-2012 проверяет OpenSSL с gost-engine: путь к openssl и его конфигу
ESIGN_OPENSSL=openssl
ESIGN_OPENSSL_CONF=
# Проверка отзыва: try (если список отзыва доступен), require (строго), off
ESIGN_CRL=try
# Сколько часов живёт токен подтверждения
ESIGN_TTL_HOURS=720

# SMTP для приглашений сотрудников (нужен серверной части, которую ещё предстоит написать)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@xn--80aa3a4ab7a.xn--p1ai
